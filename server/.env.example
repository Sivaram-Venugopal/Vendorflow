# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB: mongodb://127.0.0.1:27017/vendorflow
# MongoDB Atlas (Production): mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/vendorflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vendorflow

# Frontend Client Origin (supports comma-separated origins for production Vercel/Netlify URLs)
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_MAX=300
