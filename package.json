{
  "name": "vendorflow",
  "version": "1.0.0",
  "private": true,
  "description": "VendorFlow Procurement Portal - MERN Stack",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "test": "npm test --prefix server",
    "build": "npm run build --prefix client",
    "check:db": "node server/check-db.js",
    "seed": "npm run seed --prefix server"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
